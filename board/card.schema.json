{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtg-zkp/construction-record/v1",
  "title": "Construction record — one requested zero-knowledge proof over DTG credentials, machine-checked",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "state",
    "statement",
    "witness",
    "publicInputs",
    "relation",
    "disclosureSet",
    "doesNotEstablish",
    "adversary",
    "horizon",
    "fixtures",
    "options",
    "issuance",
    "provenance",
    "history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "enum": [
        "primitive",
        "composed"
      ]
    },
    "state": {
      "enum": [
        "requested",
        "specified",
        "constructed",
        "run",
        "vetted",
        "published"
      ]
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    },
    "owner": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "need": {
          "type": "string"
        }
      }
    },
    "statement": {
      "type": "string",
      "minLength": 20
    },
    "witness": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "publicInputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clause",
          "gadget"
        ],
        "properties": {
          "clause": {
            "type": "string"
          },
          "gadget": {
            "enum": [
              "set-membership",
              "nullifier",
              "transcript-bind",
              "key-binding",
              "distinctness",
              "signature-verify",
              "non-revocation",
              "range",
              "commitment-open",
              "chain-resolve",
              "hidden-equality"
            ]
          },
          "runtime": {
            "type": "string"
          },
          "component": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          }
        }
      }
    },
    "disclosureSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "doesNotEstablish": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "adversary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "against"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "against": {
            "type": "array",
            "items": {
              "enum": [
                "verifier",
                "verifiers-colluding",
                "issuer-verifier-colluding",
                "registry-operator"
              ]
            }
          }
        }
      }
    },
    "horizon": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "fixtures": {
      "type": "object",
      "required": [
        "families"
      ],
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "enum": [
              "accepts",
              "rejects-unsat",
              "rejects-verify",
              "unlinkable",
              "current"
            ]
          },
          "minItems": 1
        },
        "vectors": {
          "type": "string"
        },
        "rejectionCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "construction"
        ],
        "properties": {
          "construction": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "measured": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "issuance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "spec": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}$"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "by",
          "date",
          "evidence"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "task": {
            "type": "string"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "by",
          "date",
          "scope",
          "verdict"
        ],
        "properties": {
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "signed-off",
              "refined",
              "refuted",
              "pending"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "formal": {
      "type": "object",
      "description": "A machine-checked model of this record: the statement as a definition, theorems proved against it, and the hypotheses each rests on. Formal verification of the counting and policy logic is not evidence of the construction's cryptography; the hypotheses name what remains to discharge against the construction.",
      "required": [
        "system",
        "location",
        "reproduce",
        "statement",
        "theorems",
        "hypotheses",
        "scope"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "reproduce": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "theorems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "proves": {
                "type": "string"
              },
              "carries": {
                "type": "string"
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "proves": {
                "type": "string"
              },
              "carries": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
