{
  "name": "dtg-zk-book",
  "version": "0.0.1",
  "private": true,
  "license": "CC-BY-4.0",
  "description": "DTG ZK Book — Spec-Up-T rendering of the board cards in github.com/mitchuski/dtgwg-zkp-mage. recipes.md and g-*.md terms are generated by `node ../board/tools/board.mjs spec`.",
  "dependencies": {
    "dotenv": "^16.4.5",
    "spec-up-t": "^1.9.0"
  },
  "scripts": {
    "generate": "node ../board/tools/board.mjs spec",
    "render": "node --no-warnings -e \"require('spec-up-t/index.js')({ nowatch: true })\"",
    "edit": "node -e \"require('spec-up-t')()\"",
    "dev": "node -e \"require('spec-up-t')({ dev: true })\"",
    "topdf": "node -e \"require('spec-up-t/src/create-pdf.js')\"",
    "healthCheck": "node --no-warnings ./node_modules/spec-up-t/src/health-check.js"
  }
}
